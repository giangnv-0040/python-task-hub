API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Luu tru file dinh kem: local | s3
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE=10485760
LOCAL_STORAGE_DIR=storage
# Chi can khi STORAGE_BACKEND=s3 (MinIO khi dev)
S3_BUCKET=taskhub-attachments
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
